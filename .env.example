# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,https://911-wheat.vercel.app

# Frontend Client API Target (for standalone static/Vercel deployments)
# Leave unset or empty for relative '/api/v1' on same-domain / monolithic server
VITE_API_BASE_URL=https://911-wheat.vercel.app/api/v1
# VITE_API_URL=https://your-api-backend-service.com/api/v1

# Cryptographic Authentication Secrets (HMAC-SHA256 Token Signing & Session Cookies)
AUTH_SECRET=your-random-32-byte-hex-string-for-jwt-signing
SESSION_SECRET=your-random-session-secret-placeholder

# PostgreSQL Database Configuration (Phase 7 Integration)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/car911

# Optional discrete parameters for cloud environments
# SQL_HOST=localhost
# SQL_DB_NAME=car911
# SQL_USER=postgres
# SQL_PASSWORD=YOUR_PASSWORD

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
